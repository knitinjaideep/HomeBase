# Copy this file to .env.local and fill in real values from your Supabase
# project dashboard → Settings → API. Never commit .env.local (it is already
# git-ignored via the .env*.local pattern in .gitignore).
#
# Both of these are safe to expose to the browser (NEXT_PUBLIC_) — they are
# the project URL and the public anon/publishable key, not a secret. The
# running app never uses (and never should use) the Supabase service-role key;
# only the operator-run `npm run sync:geographies` command does (see below).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary site-wide preview access gate (see README.md → "Preview access
# gate"). Server-only — never prefix these with NEXT_PUBLIC_. Leave
# PREVIEW_GATE_ENABLED unset or "false" to disable (the default). When
# enabling it, PREVIEW_ACCESS_KEY and PREVIEW_COOKIE_SECRET are both
# required — generate strong random values, e.g. `openssl rand -hex 32`.
PREVIEW_GATE_ENABLED=false
PREVIEW_ACCESS_KEY=
PREVIEW_COOKIE_SECRET=

# Census-backed location data (see README → "Geography data"). Used ONLY by
# `npm run sync:geographies`, run by hand on your machine. Server-side only:
# never prefix these with NEXT_PUBLIC_, never add them to Vercel or CI, never
# commit real values. Get a Census key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Needed only for real (non --dry-run) syncs; found in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
