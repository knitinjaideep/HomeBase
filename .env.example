# Copy this file to .env.local and fill in real values from your Supabase
# project dashboard → Settings → API. Never commit .env.local (it is already
# git-ignored via the .env*.local pattern in .gitignore).
#
# Both of these are safe to expose to the browser (NEXT_PUBLIC_) — they are
# the project URL and the public anon/publishable key, not a secret. This
# app never uses (and never should use) the Supabase service-role key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
